{
    "name": "gestao-academia/gfit",
    "description": "Sistema de Gestão de Academia com Isolamento Multi-tenant e MFA",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": ">=8.2.0",
        "spomky-labs/otphp": "^11.2",
        "chillerlan/php-qrcode": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
