APP_NAME="Gestão de Academia"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/GFit/public

# Banco de Dados MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gestao_academia
DB_USERNAME=root
DB_PASSWORD=

# Sessão e Segurança
SESSION_LIFETIME=7200
SESSION_ABSOLUTE_LIFETIME=28800
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_IP_MAX_ATTEMPTS=20
AUTH_ACCOUNT_MAX_ATTEMPTS=5
PASSWORD_RESET_TIMEOUT_MINUTES=30
PASSWORD_RESET_MAX_ATTEMPTS=3

# Autenticação Multifatorial (MFA / TOTP)
# Chave externa de 32 bytes (64 caracteres hexadecimais) para criptografia autenticada AES-256-GCM dos segredos TOTP
MFA_ENCRYPTION_KEY="COLOQUE_AQUI_64_CARACTERES_HEXADECIMAIS"
MFA_ISSUER="Gestão de Academia"
MFA_CHALLENGE_TIMEOUT_MINUTES=5
MFA_MAX_ATTEMPTS=5
APP_ALLOWED_HOSTS="localhost,127.0.0.1"

# Gere chaves diferentes com: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
DATA_ENCRYPTION_KEY="COLOQUE_AQUI_64_CARACTERES_HEXADECIMAIS"
PRIVACY_FINGERPRINT_KEY="COLOQUE_AQUI_OUTRA_CHAVE_ALEATORIA"
PRIVACY_NOTICE_VERSION="2026-10-01"
PRIVACY_CONTROLLER_NAME="Nome empresarial da academia"
PRIVACY_CONTACT_EMAIL="privacidade@seudominio.com.br"
PRIVACY_SECURITY_LOG_DAYS=180
PRIVACY_APP_LOG_DAYS=90
PRIVACY_MAIL_OUTBOX_DAYS=30

# E-mail (outbox para salvar em storage/mail/ em desenvolvimento ou smtp para envio real)
MAIL_DRIVER=outbox
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@gestaoacademia.local
MAIL_FROM_NAME="Gestão de Academia"
